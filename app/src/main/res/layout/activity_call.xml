<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121224">

    <!-- Remote video: fullscreen, drawn first (behind all other views) -->
    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/surface_remote"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Emergency banner — visible only for emergency calls -->
    <TextView
        android:id="@+id/tv_emergency_banner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/label_emergency_call_banner"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="#CC0000"
        android:padding="12dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Caller name -->
    <TextView
        android:id="@+id/tv_peer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="36sp"
        android:textStyle="bold"
        android:layout_marginTop="100dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Call status (Calling… / Connected / Ended) -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#9090B0"
        android:textSize="16sp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/tv_peer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Duration timer — visible only while IN_CALL -->
    <TextView
        android:id="@+id/tv_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:fontFamily="monospace"
        android:visibility="gone"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/tv_status"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Incoming call: slide track — shown only when INCOMING -->
    <LinearLayout
        android:id="@+id/panel_incoming"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:visibility="gone"
        android:layout_marginBottom="72dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Silence — visible only for emergency incoming calls -->
        <LinearLayout
            android:id="@+id/ll_silence_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="24dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btn_silence"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_call_button"
                android:src="@drawable/ic_mic_off"
                android:padding="20dp"
                android:contentDescription="Silence" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_silence"
                android:textColor="#9090B0"
                android:textSize="12sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Slide track -->
        <FrameLayout
            android:id="@+id/slide_track"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:background="@drawable/bg_slide_track"
            android:contentDescription="@string/call_slide_track_desc">

            <!-- Decline icon at left end -->
            <ImageView
                android:id="@+id/ic_slide_decline"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="12dp"
                android:src="@drawable/ic_call_end"
                android:tint="#E53935"
                android:alpha="0.5"
                android:importantForAccessibility="no"
                android:contentDescription="" />

            <!-- Accept icon at right end -->
            <ImageView
                android:id="@+id/ic_slide_accept"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_call_white"
                android:tint="#43A047"
                android:alpha="0.5"
                android:importantForAccessibility="no"
                android:contentDescription="" />

            <!-- Draggable handle -->
            <View
                android:id="@+id/slide_handle"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_slide_handle" />
        </FrameLayout>

        <!-- Hint text row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/call_slide_to_decline"
                android:textColor="#9090B0"
                android:textSize="12sp"
                android:gravity="start" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/call_slide_to_answer"
                android:textColor="#9090B0"
                android:textSize="12sp"
                android:gravity="end" />
        </LinearLayout>

    </LinearLayout>

    <!--
        Bottom controls bar — shown when NOT incoming.
        Single horizontal row: [mute | speaker | camera | flip | screen-share] ··· [end call]
        panel_controls (the first 5) are GONE until IN_CALL.

        T7 Block C.1 (fixes end-call clipping on higher Display-size settings): panel_controls
        is now a flexible (0dp/weight=1) region instead of wrap_content, so its 5 buttons —
        each centered in its own equal-weight cell — shrink together and can never force the
        row past the screen edge. btn_end_call keeps a genuinely fixed size (never weighted)
        so it can't stretch into a pill on the one frame where it's the row's only visible
        child (CALLING/ringing, before panel_controls appears); the bar's added "|end" gravity
        keeps it pinned to the right edge in that case, replacing the old dedicated spacer View.
    -->
    <LinearLayout
        android:id="@+id/panel_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical|end"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="40dp"
        android:paddingTop="12dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!--
            Control buttons: mute + speaker + camera + flip + screen-share, each centered in
            its own equal-weight cell so they shrink together instead of overflowing the row.
            Collectively GONE until IN_CALL; fixed 56×56dp each.
        -->
        <LinearLayout
            android:id="@+id/panel_controls"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clipChildren="false"
            android:visibility="gone">

            <!-- Mute -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clipChildren="false">
                <ImageButton
                    android:id="@+id/btn_mute"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_call_button"
                    android:src="@drawable/ic_mic"
                    android:padding="14dp"
                    android:contentDescription="Mute" />
            </FrameLayout>

            <!-- Speaker -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clipChildren="false">
                <ImageButton
                    android:id="@+id/btn_speaker"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_call_button"
                    android:src="@drawable/ic_earpiece"
                    android:padding="14dp"
                    android:contentDescription="Speaker" />
            </FrameLayout>

            <!-- Camera toggle — video calls only -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clipChildren="false">
                <ImageButton
                    android:id="@+id/btn_camera"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_call_button"
                    android:src="@drawable/ic_videocam"
                    android:padding="14dp"
                    android:visibility="gone"
                    android:contentDescription="Camera" />
            </FrameLayout>

            <!-- Flip camera — video calls only -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clipChildren="false">
                <ImageButton
                    android:id="@+id/btn_flip_camera"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_call_button"
                    android:src="@drawable/ic_flip_camera"
                    android:padding="14dp"
                    android:visibility="gone"
                    android:contentDescription="Flip Camera" />
            </FrameLayout>

            <!-- Share screen — video calls only. Active/inactive conveyed via
                 background+tint (see updateScreenShareUi), same mechanism as camera/mute. -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clipChildren="false">
                <ImageButton
                    android:id="@+id/btn_screen_share"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_call_button"
                    android:src="@drawable/ic_screen_share"
                    android:padding="14dp"
                    android:visibility="gone"
                    android:contentDescription="@string/call_share_screen" />
            </FrameLayout>
        </LinearLayout>

        <!-- End Call — fixed size, never weighted, so it can't stretch into a pill when it's
             the row's only visible child (CALLING state, before panel_controls appears).
             Always visible in the bottom bar; pinned to the right edge via the bar's
             gravity="end" (replaces the old dedicated spacer View). -->
        <ImageButton
            android:id="@+id/btn_end_call"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_call_decline"
            android:src="@drawable/ic_call_end"
            android:padding="14dp"
            android:contentDescription="End Call" />
    </LinearLayout>

    <!-- Local preview: 120x160dp overlay, starts top-right, draggable to any corner -->
    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/surface_local"
        android:layout_width="120dp"
        android:layout_height="160dp"
        android:visibility="gone"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Screen-share self-preview placeholder: covers surface_local while sharing.
         The camera renderer underneath is intentionally left live (Block A) — this is a
         static overlay, not a detached/replaced renderer, so swap-back stays instant. -->
    <LinearLayout
        android:id="@+id/panel_screen_share_placeholder"
        android:layout_width="120dp"
        android:layout_height="160dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#CC121224"
        android:visibility="gone"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_screen_share"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/call_self_preview_sharing"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:gravity="center" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
