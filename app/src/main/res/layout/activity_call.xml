<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121224">

    <!-- Remote video: fullscreen, drawn first (behind all other views) -->
    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/surface_remote"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Emergency banner — visible only for emergency calls -->
    <TextView
        android:id="@+id/tv_emergency_banner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="\uD83D\uDEA8 EMERGENCY CALL"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="#CC0000"
        android:padding="12dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Caller name -->
    <TextView
        android:id="@+id/tv_peer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="36sp"
        android:textStyle="bold"
        android:layout_marginTop="100dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Call status (Calling… / Connected / Ended) -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#9090B0"
        android:textSize="16sp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/tv_peer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Duration timer — visible only while IN_CALL -->
    <TextView
        android:id="@+id/tv_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:fontFamily="monospace"
        android:visibility="gone"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/tv_status"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Incoming call: Decline + Accept — shown only when INCOMING -->
    <LinearLayout
        android:id="@+id/panel_incoming"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginBottom="72dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Silence — visible only for emergency incoming calls -->
        <LinearLayout
            android:id="@+id/ll_silence_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginEnd="40dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btn_silence"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_call_button"
                android:src="@drawable/ic_mic_off"
                android:padding="20dp"
                android:contentDescription="Silence" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Silence"
                android:textColor="#9090B0"
                android:textSize="12sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginEnd="56dp">

            <ImageButton
                android:id="@+id/btn_reject"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_call_decline"
                android:src="@drawable/ic_call_end"
                android:padding="20dp"
                android:contentDescription="Decline" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Decline"
                android:textColor="#9090B0"
                android:textSize="12sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btn_accept"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_call_accept"
                android:src="@drawable/ic_call_white"
                android:padding="20dp"
                android:contentDescription="Accept" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Accept"
                android:textColor="#9090B0"
                android:textSize="12sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </LinearLayout>

    <!--
        Bottom controls bar — shown when NOT incoming.
        Single horizontal row: [mute | speaker | camera | flip] ··· [end call]
        panel_controls (the first 4) are GONE until IN_CALL.
    -->
    <LinearLayout
        android:id="@+id/panel_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="40dp"
        android:paddingTop="12dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!--
            Control buttons: mute + speaker + camera + flip.
            Collectively GONE until IN_CALL; fixed 56×56dp each, left-aligned.
        -->
        <LinearLayout
            android:id="@+id/panel_controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <!-- Mute -->
            <ImageButton
                android:id="@+id/btn_mute"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_call_button"
                android:src="@drawable/ic_mic"
                android:padding="14dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="Mute" />

            <!-- Speaker -->
            <ImageButton
                android:id="@+id/btn_speaker"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_call_button"
                android:src="@drawable/ic_earpiece"
                android:padding="14dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="Speaker" />

            <!-- Camera toggle — video calls only -->
            <ImageButton
                android:id="@+id/btn_camera"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_call_button"
                android:src="@drawable/ic_videocam"
                android:padding="14dp"
                android:layout_marginEnd="12dp"
                android:visibility="gone"
                android:contentDescription="Camera" />

            <!-- Flip camera — video calls only -->
            <ImageButton
                android:id="@+id/btn_flip_camera"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_call_button"
                android:src="@drawable/ic_flip_camera"
                android:padding="14dp"
                android:visibility="gone"
                android:contentDescription="Flip Camera" />
        </LinearLayout>

        <!-- Spacer pushes end call to the right -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- End Call — always visible in the bottom bar -->
        <ImageButton
            android:id="@+id/btn_end_call"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_call_decline"
            android:src="@drawable/ic_call_end"
            android:padding="14dp"
            android:contentDescription="End Call" />
    </LinearLayout>

    <!-- Local preview: 120x160dp overlay, starts top-right, draggable to any corner -->
    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/surface_local"
        android:layout_width="120dp"
        android:layout_height="160dp"
        android:visibility="gone"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
