<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Set Encryption Passphrase"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose a secret passphrase for message encryption. All family members must enter the SAME passphrase on their devices. Share it with everyone before they install the app."
            android:textSize="14sp"
            android:textColor="#555555"
            android:layout_marginBottom="24dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Passphrase"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="16dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_passphrase"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Confirm passphrase"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="16dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_passphrase_confirm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1"/>
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btn_show_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Show hint"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tv_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#555555"
            android:fontFamily="sans-serif-italic"
            android:layout_marginBottom="20dp"
            android:visibility="gone" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Hint (optional — visible to server admin)"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="8dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1"/>
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Don&#8217;t use the passphrase itself as the hint."
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_marginBottom="8dp"/>

        <CheckBox
            android:id="@+id/cb_save_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save hint on server"
            android:checked="false"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="&#9888; If passphrases don&#8217;t match between devices, messages will not be readable."
            android:textSize="13sp"
            android:textColor="#D32F2F"
            android:layout_marginBottom="20dp"/>

        <CheckBox
            android:id="@+id/cb_auto_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Auto-respond to location requests from family members"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="When enabled, your location will be shared automatically when a family member requests it. Can be changed in Settings."
            android:textSize="12sp"
            android:textColor="#777777"
            android:layout_marginBottom="20dp"/>

        <Button
            android:id="@+id/btn_confirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Set Passphrase"/>

    </LinearLayout>
</ScrollView>
