<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ShapeAppearance.Fshu.Dialog" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="ThemeOverlay.Fshu.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Fshu.Dialog</item>
    </style>

    <style name="Theme.Fshu" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_orange</item>
        <item name="colorPrimaryVariant">@color/brand_orange_pressed</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/brand_orange</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/light_surface</item>
        <item name="colorOnSurface">@color/light_text_primary</item>
        <item name="android:colorBackground">@color/light_background</item>
        <item name="android:windowBackground">@color/light_background</item>
        <item name="colorBubbleSent">@color/light_bubble_sent</item>
        <item name="colorBubbleReceived">@color/light_bubble_received</item>
        <item name="colorBorder">@color/light_border</item>
        <item name="colorTextPrimary">@color/light_text_primary</item>
        <item name="colorTextSecondary">@color/light_text_secondary</item>
        <item name="colorTextTertiary">@color/light_text_tertiary</item>
        <item name="colorSurfaceElevated">@color/light_surface_elevated</item>
        <item name="colorControlNormal">@color/light_text_primary</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="toolbarStyle">@style/Widget.Fshu.Toolbar</item>
        <item name="colorSwitchThumbNormal">@color/light_text_tertiary</item>
        <item name="materialCardViewStyle">@style/Widget.Fshu.Card</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Fshu.Dialog</item>
        <item name="popupMenuStyle">@style/Widget.Fshu.PopupMenu</item>
        <item name="android:popupMenuStyle">@style/Widget.Fshu.PopupMenu</item>
        <item name="actionOverflowMenuStyle">@style/Widget.Fshu.PopupMenu</item>
    </style>

    <style name="Widget.Fshu.PopupMenu" parent="Widget.MaterialComponents.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup_menu</item>
    </style>

    <style name="Widget.Fshu.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="titleTextColor">?attr/colorTextPrimary</item>
        <item name="subtitleTextColor">?attr/colorTextSecondary</item>
        <item name="navigationIconTint">?attr/colorTextPrimary</item>
    </style>

    <style name="Widget.Fshu.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">?attr/colorSurfaceElevated</item>
        <item name="strokeColor">?attr/colorBorder</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="BottomSheetStyle" parent="Theme.MaterialComponents.BottomSheetDialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="bottomSheetStyle">@style/Widget.Fshu.BottomSheet</item>
    </style>

    <style name="Widget.Fshu.BottomSheet" parent="Widget.MaterialComponents.BottomSheet">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Fshu.BottomSheet</item>
    </style>

    <style name="ShapeAppearance.Fshu.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
</resources>
